<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.douyin-monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_WITH_REPO_PATH/douyin-monitor/run_account_monitor.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>5</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_OUTPUT_PATH/schedule.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_OUTPUT_PATH/schedule.err.log</string>
</dict>
</plist>
